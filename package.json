{
  "name": "youtrack-mcp",
  "version": "1.0.0",
  "description": "MCP server for the YouTrack REST API",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "youtrack-mcp": "src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.19.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.4",
    "typescript": "^5.7.3"
  }
}
